.DS_Store
**/.DS_Store

# Ignore local artifacts and temporary files
software_design_text.txt
yourprevconvo.md

# Maintainer session context (not project docs — internal reasoning only).
# ⚠️  DO NOT DELETE these files. They are intentionally kept local (gitignored)
#     so the maintainer can reference them across future sessions.
docs/key_decisions_log.md
docs/non_negotiables.md
docs/gpt53_codex_prompt.md
gpt53_codex_prompt

# Python cache and compiled files
__pycache__/
**/__pycache__/
*.py[cod]
*.so

# Ignore protein_fetch.py output files
protein
proteins.fasta
pdb_files/

# Ignore user data contents (real pipeline runs) but keep the folder structure.
# Drop PDBs into data/input/, pairs into data/input/pairs/, outputs land in data/output/.
data/input/*
!data/input/.gitkeep
!data/input/pairs/
data/input/pairs/*
!data/input/pairs/.gitkeep
data/output/*
!data/output/.gitkeep
!data/output/scores/
!data/output/plots/
data/output/scores/*
!data/output/scores/.gitkeep
data/output/plots/*
!data/output/plots/.gitkeep

# Ignore local scripts folder (runbooks, HPC scripts)
scripts/

# Vendored third-party source (cloned/built by setup.sh, e.g. Iter-CONSRANK)
third_party/

# Build metadata / packaging artifacts
src/ppinsight.egg-info/

# Cache and notebook checkpoints
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/

# Maintainer's own run notes, HPC guides, and job logs (kept local)
docs/docking_input_provenance.md
docs/future_plans.md
docs/findings.md
docs/dimeric_benchmarking.md
docs/hyak_resource_planning.md
docs/run_haddock_hyak.md
hyak-*.out
hyak-*.err

# Course deliverables (kept local)
docs/functional_spec.md
docs/PPInsight Final Presentation.pdf
docs/PPInsight_Technology_Review.pptx
