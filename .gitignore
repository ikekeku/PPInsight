.DS_Store
**/.DS_Store

# Ignore local test artifacts and temporary homework files
Unit-tests.ipynb
hw3README.md
software_design_text.txt
yourprevconvo.md

# Maintainer session context (not project docs — internal reasoning only).
# ⚠️  DO NOT DELETE these files. They are intentionally kept local (gitignored)
#     so the maintainer can reference them across future sessions.
docs/key_decisions_log.md
docs/non_negotiables.md

# Python cache and compiled files
__pycache__/
**/__pycache__/
*.py[cod]
*.so

# Ignore protein_fetch.py output files
protein
proteins.fasta
pdb_files/

# Ignore example output files generated by runs (LightDock/HADDOCK outputs)
examples/ppinsight_data/output_files/

# Ignore user data contents (real pipeline runs) but keep the folder structure.
# Drop PDBs into data/input/, pairs into data/input/pairs/, outputs land in data/output/.
data/input/*
!data/input/.gitkeep
!data/input/pairs/
data/input/pairs/*
!data/input/pairs/.gitkeep
data/output/*
!data/output/.gitkeep

# Ignore local scripts folder (runbooks, HPC scripts)
scripts/

# Build metadata / packaging artifacts
src/ppinsight.egg-info/

# Cache and notebook checkpoints
.pytest_cache/
.ipynb_checkpoints/

# Ignore example run folders sourced from respective tools
examples/haddock3/run1-test/
examples/lightdock/simulation/
examples/rosetta/Protein-Protein-Docking/